root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json,sh}]
indent_size = 2
